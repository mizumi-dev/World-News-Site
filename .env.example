# ニュース取得プロバイダ: newsdata | worldnewsapi
NEWS_PROVIDER=newsdata

# NewsData.io の APIキー (https://newsdata.io/register で無料取得)
NEWSDATA_API_KEY=

# World News API の APIキー (https://worldnewsapi.com で取得。NEWS_PROVIDER=worldnewsapi の時のみ必要)
WORLDNEWS_API_KEY=

# Qwen (Alibaba Cloud) の APIキー
QWEN_API_KEY=

# Qwen のOpenAI互換エンドポイント。国際版はデフォルトのままでOK。
# 中国本土のアカウントの場合は https://dashscope.aliyuncs.com/compatible-mode/v1 に変更する
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# 要約に使うモデル。コンソールで利用可能なモデル名を確認して設定する
QWEN_MODEL=qwen3.7-flash

# 1カ国あたりの取得・要約記事数の上限
MAX_ARTICLES_PER_COUNTRY=10

# リフレッシュ時にキャッシュを使う時間(分)
CACHE_TTL_MINUTES=15
