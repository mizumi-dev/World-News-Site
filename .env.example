# ニュース取得プロバイダ: newsdata | worldnewsapi | googlenews
# googlenews は Google News RSS を使う（APIキー不要・無料だが非公式。docs/ARCHITECTURE_REVIEW.md 参照）
NEWS_PROVIDER=newsdata

# NewsData.io の APIキー (https://newsdata.io/register で無料取得)
NEWSDATA_API_KEY=

# World News API の APIキー (https://worldnewsapi.com で取得。NEWS_PROVIDER=worldnewsapi の時のみ必要)
WORLDNEWS_API_KEY=

# Qwen (Alibaba Cloud) の APIキー
QWEN_API_KEY=

# Qwen のOpenAI互換エンドポイント。国際版はデフォルトのままでOK。
# 中国本土のアカウントの場合は https://dashscope.aliyuncs.com/compatible-mode/v1 に変更する
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# 要約に使うモデル。コンソールで利用可能なモデル名を確認して設定する
QWEN_MODEL=qwen3.7-flash

# 1カ国あたりの取得・要約記事数の上限
MAX_ARTICLES_PER_COUNTRY=10

# リフレッシュ時にキャッシュを使う時間(分)
CACHE_TTL_MINUTES=15

# 永続キャッシュ(Upstash Redis)。ローカル開発では未設定でOK(.cache/ フォルダが自動的に使われる)。
# Vercel等にデプロイする場合は必須(サーバーレス環境はファイルが永続しないため)。
# Vercelダッシュボードの Marketplace から「Upstash for Redis」を追加すると自動で設定される。
# 手動で作る場合は https://upstash.com で無料データベースを作成し、REST URL/TOKENをコピーする。
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Cronによる自動更新(/api/cron/refresh)の認証キー。ローカル開発では未使用。
# Vercelにデプロイする場合は、ランダムな文字列を生成してこの値とVercelの環境変数の両方に設定する
# （例: openssl rand -hex 32）。Vercelはcron実行時にこの値を Authorization ヘッダで自動送信する。
CRON_SECRET=

# 埋め込みベクトルによる重複判定（段階③、docs/SPEC.md 8-2）。デフォルトはオフ。
# trueにすると、Qwenの埋め込みAPIで言い回しが異なる同一ニュースの検出精度が上がるが、
# 埋め込みAPIの呼び出しが追加で発生する。まずは効果を見てから有効化することを推奨する。
ENABLE_EMBEDDING_DEDUP=false
QWEN_EMBEDDING_MODEL=text-embedding-v4
